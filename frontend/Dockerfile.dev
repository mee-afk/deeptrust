# FROM node:18-alpine
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

RUN npm install @rollup/rollup-linux-x64-musl --optional 2>/dev/null || true

# Copy source
COPY . .

# Expose port
EXPOSE 5173

# Use environment variable to force host binding
ENV HOST=0.0.0.0

# Start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
# CMD ["npm", "run", "dev"]

